{
  "name": "@org/backend-core",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BoutiqueManager/backend-core.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./entities": {
      "types": "./dist/entities/index.d.ts",
      "default": "./dist/entities/index.js"
    },
    "./enums": {
      "types": "./dist/enums/index.d.ts",
      "default": "./dist/enums/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "entities": [
        "dist/entities/index.d.ts"
      ],
      "enums": [
        "dist/enums/index.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "typeorm": "^0.3.28 || ^1.0.0"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typeorm": "^1.0.0"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  }
}
